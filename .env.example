# --- App ---
APP_ENV=dev
LOG_LEVEL=DEBUG
PUBLIC_BASE_URL=http://localhost:8000

# --- Gemini (LangChain) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_TOP_P=0.95
# Intake replies are a full JSON object — too small a budget truncates them.
GEMINI_MAX_TOKENS=4096
# 0 disables Gemini 2.5 "thinking" so the whole budget goes to the JSON answer.
GEMINI_THINKING_BUDGET=0

# --- NVIDIA NIM (optional / unused) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=1
NVIDIA_MAX_TOKENS=1024
NVIDIA_SEED=42

# --- Database (PostgreSQL only) ---
# Local:  postgresql+psycopg://postgres:postgres@localhost:5432/voice_system
# Aiven:  postgresql+psycopg://<user>:<password>@pg-214cb6-jrdsi.d.aivencloud.com:26317/defaultdb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_system
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seeded into clinic_settings on first boot only; DB is source of truth afterward.
CLINIC_NAME=Our Clinic

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Human agent E.164 number for AI → human cold transfer
TWILIO_HUMAN_AGENT_NUMBER=

# --- LiveKit (open-source self-hosted; docker compose --dev defaults) ---
LIVEKIT_URL=ws://localhost:7880
# Public WSS URL for browser clients (nginx proxies /rtc → LiveKit).
# Empty = derive from PUBLIC_BASE_URL (https://x → wss://x).
LIVEKIT_PUBLIC_URL=wss://voice.sumitmandal.in
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_HOST=

# --- Voice models ---
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_VOICE=alba
TTS_SAMPLE_RATE=24000

# --- AWS SES (email agent auto-reply; sandbox OK) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified From identity (e.g. intake@sumitmandal.in or your verified Gmail)
SES_FROM_ADDRESS=intake@sumitmandal.in
# Optional: S3 bucket if SES receipt rule stores raw MIME
SES_INBOUND_BUCKET=
