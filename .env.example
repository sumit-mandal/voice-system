# --- App ---
APP_ENV=dev
LOG_LEVEL=DEBUG
PUBLIC_BASE_URL=http://localhost:8000

# --- Gemini (LangChain) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_TOP_P=0.95
GEMINI_MAX_TOKENS=1024

# --- NVIDIA NIM (optional / unused) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=1
NVIDIA_MAX_TOKENS=1024
NVIDIA_SEED=42

# --- SQLite ---
DATABASE_URL=sqlite:///./data/healthcare_voice.db

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Human agent E.164 number for AI → human cold transfer
TWILIO_HUMAN_AGENT_NUMBER=

# --- LiveKit (open-source self-hosted; docker compose --dev defaults) ---
LIVEKIT_URL=ws://localhost:7880
# Public WSS URL for browser clients (nginx proxies /rtc → LiveKit).
# Empty = derive from PUBLIC_BASE_URL (https://x → wss://x).
LIVEKIT_PUBLIC_URL=wss://voice.sumitmandal.in
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_HOST=

# --- Voice models ---
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_VOICE=alba
TTS_SAMPLE_RATE=24000
